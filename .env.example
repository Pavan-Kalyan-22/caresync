# CareSync Backend Environment Variables Template
# Copy this file to:
#   .env.dev   -> for local development (used by .\scripts\run-dev.ps1)
#   .env.test  -> for local testing     (used by .\scripts\run-test.ps1)
#   .env.prod  -> for production       (used by .\scripts\run-prod.ps1)
#
# NOTE: .env and .env.* files are strictly git-ignored.
# DO NOT put real passwords or production secrets into this template.

# Spring Datasource Configuration
SPRING_DATASOURCE_URL=
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=

# MySQL Container Configuration (Docker Compose)
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=

# Email Configuration (Gmail SMTP)
MAIL_USERNAME=
MAIL_PASSWORD=

# JWT Configuration (generate with: openssl rand -base64 32)
JWT_SECRET=

# Spring Profiles (dev, test, prod)
SPRING_PROFILES_ACTIVE=

# Server Configuration
SERVER_PORT=8080

# Logging
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_COM_CARESYNC=DEBUG
