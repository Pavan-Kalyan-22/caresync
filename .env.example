# CareSync Backend Environment Variables
# Copy this file to .env and fill in the actual values

# Database Configuration
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=caresync_db
MYSQL_USER=caresync_user
MYSQL_PASSWORD=caresync_pass

# Email Configuration (Gmail SMTP)
# Generate App Password from: https://myaccount.google.com/apppasswords
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password

# JWT Configuration
# Generate using: openssl rand -base64 32 (minimum 32 characters)
JWT_SECRET=your-secret-key-min-256-bits-long-for-production-use

# Spring Profiles
SPRING_PROFILES_ACTIVE=prod

# Server Configuration
SERVER_PORT=8080

# Logging
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_COM_CARESYNC=DEBUG
